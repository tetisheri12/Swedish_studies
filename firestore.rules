rules_version = '2';
// Paste this into Firebase console → Firestore Database → Rules.
// Keep the Gmail list the same as SYNC_ALLOWED_EMAILS in firebase-config.js.
service cloud.firestore {
  match /databases/{database}/documents {
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['semramacar@gmail.com', 'mcahmetcinar@gmail.com'];
    }
    // Each person can only see and change their own saved progress.
    match /users/{uid}/{document=**} {
      allow read, write: if allowed() && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow read, write: if allowed() && request.auth.uid == uid;
    }
  }
}
